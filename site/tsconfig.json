{
	"compilerOptions": {
		"lib": ["ESNext", "DOM"],
		"target": "ESNext",
		"module": "Preserve",
		"moduleResolution": "bundler",
		"jsx": "preserve",
		"jsxImportSource": "@solidjs/web",
		"types": ["bun", "vite/client"],
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"noUncheckedIndexedAccess": true
	},
	"include": ["src", "scripts", "deploy"]
}
