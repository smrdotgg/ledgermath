{
	"name": "ledgermath-site",
	"license": "Apache-2.0",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun scripts/variations/serve.ts --watch",
		"build": "bun scripts/variations/build-all.ts",
		"build:variation": "bun scripts/variations/build-one.ts",
		"serve:variation": "bun scripts/variations/serve.ts",
		"preview": "bun scripts/serve.ts",
		"typecheck": "tsc --noEmit",
		"check": "bun scripts/check-output.ts && bun scripts/variations/check-built.ts && bun scripts/variations/check-links.ts",
		"check:variation": "bun scripts/variations/check.ts",
		"shots": "bun scripts/variations/shots.ts",
		"variations:publish": "bun scripts/variations-publish.ts"
	},
	"dependencies": {
		"@solidjs/web": "2.0.1",
		"solid-js": "2.0.1"
	},
	"devDependencies": {
		"@solidjs/vite-plugin": "3.0.1",
		"@types/bun": "1.3.14",
		"ajv": "8.20.0",
		"axe-core": "4.14.0",
		"playwright": "1.65.0",
		"typescript": "7.0.2",
		"vite": "8.3.8"
	}
}
