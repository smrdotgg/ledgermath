#!/usr/bin/python3 -I
"""A stand-in for the aws CLI inside scripts/box-in-container/run.sh.

It understands only the `aws s3 cp` and `aws s3 sync` calls runner/box.sh
makes, and keeps the bucket as a directory: s3://<bucket>/<key> is
/fake-s3/<bucket>/<key>. It allows what the box's instance role allows
(infra/runs/stack.ts) and refuses the rest, so a box.sh that reads, lists or
writes elsewhere fails here too:

    read   source/<anything>
    list   blobs/
    write  runs/, blobs/, boots/, logs/

and the four read-only EC2 calls runner/provision.py and runner/run.py make,
which the role allows and nothing else of EC2:

    describe-instance-types   the catalog record AWS gave for the type, saved
                              in /fake-ec2/describe-instance-types-<type>.json
                              (scripts/box-in-container/ec2/); another type is
                              refused as AWS refuses an unknown one
    describe-volumes          one 8 GiB gp3 root volume attached to the
    describe-volume-status    instance asked about, and its status, with the
    describe-instances        documentation's example ids; the instance's own
                              record, as small

An answer saved as /fake-ec2/<action>.json is given instead, whatever was
asked: a boot on a real instance without credentials replays what the API
said about that instance.

Every EC2 call is appended to /fake-calls/ec2.log.

`sync` uploads a file the bucket lacks, or holds at another size; without
--size-only, also one whose local copy is newer, as the real CLI does. Every
object written is appended to /fake-calls/puts.log.

Two variables make it fail on purpose:

    FAKE_S3_REJECT=<prefix>     refuse every write under the prefix
    FAKE_S3_FAIL_ONCE=<prefix>  fail the first command that writes under the
                                prefix, halfway through its files
"""

import fnmatch
import json
import os
import shutil
import sys

ROOT = "/fake-s3"
READ = ("source/",)
WRITE = ("runs/", "blobs/", "boots/", "logs/")
LIST = ("blobs/",)
PUTS = "/fake-calls/puts.log"
REJECT = os.environ.get("FAKE_S3_REJECT", "")
FAIL_ONCE = os.environ.get("FAKE_S3_FAIL_ONCE", "")
FAILED_ONCE = "/fake-calls/failed-once"


def fail(message):
    print("aws (stub): " + message, file=sys.stderr)
    sys.exit(1)


def split(url):
    bucket, _, key = url[len("s3://"):].partition("/")
    if not bucket or not key:
        fail("not an s3://bucket/key URL: " + url)
    return bucket, key


def put(path, bucket, key):
    if not key.startswith(WRITE):
        fail("AccessDenied: PutObject on %s is outside %s" % (key, ", ".join(WRITE)))
    if REJECT and key.startswith(REJECT):
        fail("AccessDenied (FAKE_S3_REJECT): PutObject on " + key)
    target = os.path.join(ROOT, bucket, key)
    os.makedirs(os.path.dirname(target), exist_ok=True)
    shutil.copyfile(path, target)
    with open(PUTS, "a") as handle:
        handle.write(key + "\n")


def needs_upload(local, remote, size_only):
    if not os.path.exists(remote) or os.path.getsize(local) != os.path.getsize(remote):
        return True
    return not size_only and os.path.getmtime(local) > os.path.getmtime(remote)


EC2_ACTIONS = ("describe-instance-types", "describe-volumes", "describe-volume-status", "describe-instances")
ACCOUNT = "123456789012"  # the documentation's example account
VOLUME = "vol-0123456789abcdef0"


def ec2(args):
    with open("/fake-calls/ec2.log", "a") as handle:
        handle.write(" ".join(args) + "\n")
    action = args[0] if args else ""
    if action not in EC2_ACTIONS:
        fail("An error occurred (UnauthorizedOperation) when calling ec2 %s: the box's role allows only %s" % (action, ", ".join(EC2_ACTIONS)))
    # An option takes every word up to the next option.
    options, current = {}, None
    for arg in args[1:]:
        if arg.startswith("--"):
            current = options.setdefault(arg, [])
        elif current is not None:
            current.append(arg)
    if options.get("--output") != ["json"] or not options.get("--region"):
        fail("expected --region and --output json, got %r" % options)
    saved = "/fake-ec2/%s.json" % action
    if os.path.isfile(saved):
        with open(saved) as handle:
            sys.stdout.write(handle.read())
        return
    if action == "describe-instance-types":
        (instance_type,) = options["--instance-types"]
        path = "/fake-ec2/describe-instance-types-%s.json" % instance_type
        if not os.path.isfile(path):
            fail("An error occurred (InvalidInstanceType) when calling the DescribeInstanceTypes operation: The following supplied instance types do not exist: [%s]" % instance_type)
        with open(path) as handle:
            sys.stdout.write(handle.read())
        return
    if action == "describe-volumes":
        (filter_text,) = options["--filters"]
        instance = filter_text.split("Values=", 1)[1]
        answer = {"Volumes": [{
            "Attachments": [{"DeleteOnTermination": True, "VolumeId": VOLUME, "InstanceId": instance, "Device": "/dev/xvda",
                             "State": "attached", "AttachTime": "2026-11-11T00:00:00+00:00"}],
            "AvailabilityZone": "us-east-2c", "AvailabilityZoneId": "use2-az3", "CreateTime": "2026-11-11T00:00:00+00:00",
            "Encrypted": False, "Size": 8, "SnapshotId": "snap-0123456789abcdef0", "State": "in-use", "VolumeId": VOLUME,
            "Iops": 3000, "VolumeType": "gp3", "MultiAttachEnabled": False, "Throughput": 125, "OwnerId": ACCOUNT}]}
    elif action == "describe-volume-status":
        answer = {"VolumeStatuses": [{
            "Actions": [], "AvailabilityZone": "us-east-2c", "AvailabilityZoneId": "use2-az3", "Events": [], "VolumeId": volume,
            "VolumeStatus": {"Details": [{"Name": "io-enabled", "Status": "passed"}, {"Name": "io-performance", "Status": "normal"},
                                         {"Name": "initialization-state", "Status": "initializing"}], "Status": "ok"},
            "InitializationStatusDetails": {"InitializationType": "default", "Progress": 42}} for volume in options["--volume-ids"]]}
    else:
        (instance,) = options["--instance-ids"]
        answer = {"Reservations": [{"Groups": [], "OwnerId": ACCOUNT, "ReservationId": "r-0123456789abcdef0", "Instances": [{
            "InstanceId": instance, "ImageId": "ami-0123456789abcdef0", "State": {"Code": 16, "Name": "running"},
            "Placement": {"AvailabilityZone": "us-east-2c", "AvailabilityZoneId": "use2-az3", "Tenancy": "default"},
            "RootDeviceName": "/dev/xvda", "RootDeviceType": "ebs",
            "BlockDeviceMappings": [{"DeviceName": "/dev/xvda", "Ebs": {"VolumeId": VOLUME, "Status": "attached",
                                                                       "DeleteOnTermination": True, "AttachTime": "2026-11-11T00:00:00+00:00"}}]}]}]}
    json.dump(answer, sys.stdout, indent=4)
    sys.stdout.write("\n")


def main(args):
    if args[:1] == ["ec2"]:
        ec2(args[1:])
        return
    if args[:2] not in (["s3", "cp"], ["s3", "sync"]):
        fail("only `aws s3 cp` and `aws s3 sync`, and four EC2 calls, are stubbed, got: aws " + " ".join(args))
    syncing = args[1] == "sync"
    size_only = False
    recursive = syncing
    excludes = []
    positional = []
    rest = iter(args[2:])
    for arg in rest:
        if arg == "--recursive":
            recursive = True
        elif arg == "--only-show-errors":
            pass
        elif arg == "--size-only" and syncing:
            size_only = True
        elif arg == "--exclude":
            excludes.append(next(rest))
        elif arg == "--content-type":
            next(rest)
        elif arg.startswith("--"):
            fail("unstubbed option " + arg)
        else:
            positional.append(arg)
    if len(positional) != 2:
        fail("expected a source and a destination, got %r" % positional)
    source, destination = positional

    if source.startswith("s3://"):
        if recursive:
            fail("recursive download is not stubbed")
        bucket, key = split(source)
        if not key.startswith(READ):
            fail("AccessDenied: GetObject on %s is outside %s" % (key, ", ".join(READ)))
        path = os.path.join(ROOT, bucket, key)
        if not os.path.isfile(path):
            fail("NoSuchKey: " + source)
        shutil.copyfile(path, destination)
    elif destination.startswith("s3://"):
        bucket, key = split(destination)
        if not recursive:
            put(source, bucket, key)
            return
        files = []
        for parent, _, names in os.walk(source):
            for name in names:
                relative = os.path.relpath(os.path.join(parent, name), source)
                if not any(fnmatch.fnmatch(relative, pattern) for pattern in excludes):
                    files.append(relative)
        prefix = key.rstrip("/") + "/"
        if syncing:
            if not prefix.startswith(LIST):
                fail("AccessDenied: ListBucket on %s is outside %s" % (prefix, ", ".join(LIST)))
            files = [relative for relative in files if needs_upload(os.path.join(source, relative),
                                                                    os.path.join(ROOT, bucket, prefix + relative), size_only)]
        fail_halfway = FAIL_ONCE and prefix.startswith(FAIL_ONCE) and not os.path.exists(FAILED_ONCE)
        for number, relative in enumerate(sorted(files)):
            if fail_halfway and number == len(files) // 2:
                open(FAILED_ONCE, "w").close()
                fail("InternalError (FAKE_S3_FAIL_ONCE): the connection dropped after %d of %d files" % (number, len(files)))
            put(os.path.join(source, relative), bucket, prefix + relative)
    else:
        fail("neither side is s3://")


main(sys.argv[1:])
